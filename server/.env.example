# Intellix API — environment template
# Copy to .env and fill in real values. NODE_ENV=production refuses weak secrets.

# PostgreSQL (Railway/Neon/Supabase connection string)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Auth
# Strong random value (min 16 chars, no 'dev'/'example' strings)
JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
JWT_EXPIRES_IN="1d"
# Comma-separated emails that auto-become ADMIN on first login
ADMIN_EMAILS="you@example.com"

# AES-256 master key for provider API keys (min 32 chars)
MASTER_KEY="generate-with: node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""

# Google OAuth (idToken verification). Get from Google Cloud Console.
GOOGLE_CLIENT_ID=""

# Comma-separated list of allowed browser origins (empty = allow all, dev only)
CORS_ORIGINS="https://admin.example.com"

# Server
PORT=3000
NODE_ENV=production
