generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  avatarUrl    String?
  passwordHash String? // only for email/password accounts
  role         Role          @default(USER)
  provider    String        @default("email") // email | google
  dailyQuota  Int           @default(20)
  banned      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  lastLoginAt DateTime?
  usage       UsageRecord[]
  auditLogs   AuditLog[]
  projects    Project[]     @relation("ProjectOwner")
  generations Generation[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  secretKey   String   @unique
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workflows   Workflow[]
  executions  WorkflowExecution[]
}

model AiProvider {
  id           String        @id @default(cuid())
  name         String        @unique // openai | stability | pollinations | fal ...
  displayName  String
  icon         String        @default("⚡")
  baseUrl      String
  chatEndpoint String?
  imageEndpoint String?
  embeddingEndpoint String?
  speechEndpoint String?
  visionEndpoint String?
  apiKeyEnc    String? // AES-256-GCM encrypted; null = keyless (e.g. Pollinations)
  organizationId String?
  headers      Json          @default("{}")
  queryParams  Json          @default("{}")
  enabled      Boolean       @default(true)
  priority     Int           @default(0)
  weight       Int           @default(1)
  timeoutMs    Int           @default(120000)
  retryCount   Int           @default(3)
  cooldownMs   Int           @default(30000)
  costPer1kIn  Float         @default(0)
  costPer1kOut Float         @default(0)
  maxRpm       Int           @default(60)
  maxTpm       Int           @default(100000)
  dailyQuota   Int? // null = unlimited
  monthlyQuota Int?
  maxContext   Int?
  maxOutput    Int?
  supportsStreaming     Boolean @default(true)
  supportsVision        Boolean @default(false)
  supportsImages        Boolean @default(true)
  supportsVideo         Boolean @default(false)
  supportsAudio         Boolean @default(false)
  supportsFunctionCalling Boolean @default(true)
  supportsJsonMode      Boolean @default(true)
  healthStatus String    @default("unknown") // unknown | healthy | degraded | down
  lastHealthCheck DateTime?
  failureStreak Int      @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  usage        UsageRecord[]
  models       AiModel[]
  failoverRules RoutingRule[]
  credentials  ProviderCredential[]
}

model AiModel {
  id           String   @id @default(cuid())
  providerId   String
  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  displayName  String   // GPT-5
  internalName String   // gpt-5
  costPer1kIn  Float    @default(0)
  costPer1kOut Float    @default(0)
  priority     Int      @default(0)
  weight       Int      @default(1)
  maxTokens    Int?
  temperatureLimit Float? @default(2)
  supportsImages      Boolean @default(false)
  supportsVision      Boolean @default(false)
  supportsVideo       Boolean @default(false)
  supportsAudio       Boolean @default(false)
  supportsToolCalls   Boolean @default(true)
  supportsStreaming   Boolean @default(true)
  supportsJson        Boolean @default(true)
  supportsFunctionCalling Boolean @default(true)
  supportsReasoning   Boolean @default(false)
  enabled      Boolean  @default(true)
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  variableRoutes RoutingVariableRoute[]
  failoverRules RoutingRule[]
  capabilities ModelCapability[]

  @@unique([providerId, internalName])
  @@index([enabled, hidden])
}

model RoutingVariable {
  id          String   @id @default(cuid())
  name        String   @unique // FAST | QUALITY | CHEAP ...
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  routes      RoutingVariableRoute[]
}

model RoutingVariableRoute {
  id         String   @id @default(cuid())
  variableId String
  variable   RoutingVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  modelId    String
  model      AiModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  order      Int
  createdAt  DateTime @default(now())

  @@unique([variableId, modelId])
}

model RoutingRule {
  id              String     @id @default(cuid())
  name            String
  enabled         Boolean    @default(true)
  trigger         String     // provider_failed | quota_exceeded | latency_gt | balance_low | request_type | user_tier | image_request
  condition       Json?      // { field, operator, value }
  action          String     // switch_provider | switch_model | retry | failover | disable_provider | limit_rate
  targetProviderId String?
  targetProvider  AiProvider? @relation(fields: [targetProviderId], references: [id], onDelete: SetNull)
  targetModelId   String?
  targetModel     AiModel?    @relation(fields: [targetModelId], references: [id], onDelete: SetNull)
  priority        Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model UsageRecord {
  id         String     @id @default(cuid())
  userId     String
  providerId String
  prompt     String
  imageCount Int
  costUsd    Float      @default(0)
  status     String     @default("success") // success | error | quota
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id])
  provider   AiProvider @relation(fields: [providerId], references: [id])
}

model Setting {
  key   String @id
  value Json
}

model Generation {
  id            String   @id @default(cuid())
  userId        String
  prompt        String
  negativePrompt String?
  resolution    String   @default("medium")
  ratio         String   @default("1:1")
  model         String?
  provider      String
  sizeW         Int
  sizeH         Int
  imageCount    Int
  status        String   @default("success") // success | error
  images        Json     @default("[]") // array of base64 data URLs
  costUsd       Float    @default(0)
  error         String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}

/**
 * Capability registry — every AI tool / capability node maps to a row here.
 * Admin can enable/disable capabilities, edit their default model chain and
 * preview their typed ports without touching code. New capabilities are
 * seeded, then matched by `key` in the execution engine; `hasRuntime` marks
 * capabilities whose runtime handler exists (others appear in the Node
 * Library but are disabled until an adapter is added).
 */
model Capability {
  id             String   @id @default(cuid())
  key            String   @unique // image | icon | logo | object3d | video | backgroundRemover | upscaler | textGeneration | ...
  name           String
  kind           String   @default("capability") // capability | logic | storage | trigger | system
  category       String   @default("AI") // AI | Logic | Storage | System | Canvas
  description    String?
  icon           String   @default("🧰")
  color          String   @default("bg-blue-500/15 text-blue-400 border-blue-500/30")
  capability     String   @default("image") // image | video | mask | audio | chat | text
  requiresInput  Boolean  @default(false) // true when the capability consumes an uploaded artifact
  enabled        Boolean  @default(true)
  inputPorts     Json     @default("[]") // [{ id, label, dataType, required, accepts? }]
  outputPorts    Json     @default("[]") // [{ id, label, dataType }]
  paramSchema    Json     @default("{}") // field definitions rendered in the properties panel
  defaults       Json     @default("{}") // default node config
  hasRuntime     Boolean  @default(true) // false = registered but no runtime handler yet
  defaultChain   Json     @default("[]") // ordered [{ provider, model }] fallback steps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/**
 * Typed connection between a model and a capability. Backfilled from the
 * provider/model capability flags on seed; admin can override per model.
 */
model ModelCapability {
  id             String      @id @default(cuid())
  modelId        String
  model          AiModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  capabilityKey  String
  supported      Boolean     @default(true)
  priority       Int         @default(0)
  config         Json?
  createdAt      DateTime    @default(now())

  @@unique([modelId, capabilityKey])
  @@index([capabilityKey])
}

/**
 * Multiple encrypted credentials per provider — routing tries them by
 * priority and rotates on failure before moving to another provider.
 */
model ProviderCredential {
  id            String      @id @default(cuid())
  providerId    String
  provider      AiProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label         String
  apiKeyEnc     String // AES-256-GCM encrypted; never exposed to clients
  enabled       Boolean     @default(true)
  priority      Int         @default(0) // lower = tried first
  failureStreak Int         @default(0)
  lastUsedAt    DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([providerId, enabled, priority])
}

/**
 * Named, reusable fallback route groups (Admin → Model Routes). A modelRoute
 * canvas node can reference one of these or carry its own inline steps.
 */
model ModelRoute {
  id          String   @id @default(cuid())
  name        String
  description String?
  steps       Json     @default("[]") // [{ provider, model, priority }]
  retryPolicy Json     @default("{}") // { attempts, delayMs, backoff, retryableErrors }
  enabled     Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * Static registry of non-capability node types (trigger, logic, storage,
 * system, canvas) + the dynamic modelNode/modelRoute nodes. Served to the
 * frontend so the Node Library is generated from the backend.
 */
model NodeDefinition {
  id          String   @id @default(cuid())
  key         String   @unique // trigger | retry | if | switch | wait | delay | storageNode | logger | modelNode | modelRoute | note | group
  kind        String   @default("logic") // trigger | capability | logic | storage | system | canvas
  category    String   @default("Logic") // Triggers | Logic | Storage | System | Canvas | Provider
  name        String
  description String?
  icon        String   @default("🧩")
  color       String   @default("bg-slate-500/15 text-slate-400 border-slate-500/30")
  inputPorts  Json     @default("[]")
  outputPorts Json     @default("[]")
  paramSchema Json     @default("{}")
  defaults    Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * Storage backends (local | cloudinary | s3-compatible). The workflow only
 * sees a storage node + route; the active provider is chosen here.
 */
model StorageProvider {
  id         String   @id @default(cuid())
  name       String
  driver     String   @default("local") // local | cloudinary | s3 | r2 | supabase
  configEnc  Json?    // encrypted credentials/config
  enabled    Boolean  @default(true)
  isActive   Boolean  @default(false)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/**
 * Real output of a storage node — every persisted asset gets a row so the
 * admin panel can browse stored files and executions can reference them.
 */
model StorageAsset {
  id          String              @id @default(cuid())
  executionId String?
  execution   WorkflowExecution?  @relation(fields: [executionId], references: [id], onDelete: SetNull)
  workflowId  String?
  nodeId      String?
  tool        String              @default("image")
  provider    String?
  model       String?
  kind        String              @default("image") // image | video | audio | file
  mime        String?
  url         String? // public URL when an object store is configured
  localPath   String?
  cloudinaryPublicId String? // cloudinary asset id for secure delete
  sizeBytes   Int                 @default(0)
  createdBy   String?
  storageProviderId String?
  createdAt   DateTime            @default(now())

  @@index([createdAt])
  @@index([executionId])
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  graph       Json
  draftGraph  Json?
  status      String   @default("published") // draft | published
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  webhookUrl  String? // Discord / custom URL notified on client execution finish
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  executions  WorkflowExecution[]
  versions    WorkflowVersion[]
}

model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version     Int
  graph       Json
  note        String?
  createdBy   String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([workflowId, version])
}

model WorkflowExecution {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  source     String   @default("admin") // admin | client
  createdBy  String?  // user id that triggered the run
  status     String   @default("pending") // pending | running | success | error
  input      Json?
  output     Json?
  logs       Json     @default("[]")
  attempts   Json     @default("[]") // per-node routing attempts: [{nodeId, provider, model, attempt, status, latencyMs, error, costUsd}]
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  images     Int      @default(0)
  costUsd    Float    @default(0)
  providerUsed String?
  modelUsed    String?
  durationMs Int      @default(0)
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  cancelRequestedAt DateTime?
  assets     StorageAsset[]
  steps      ExecutionStep[]

  @@index([workflowId, startedAt])
  @@index([projectId, startedAt])
}

/**
 * Per-node execution record — the real trace of a workflow run, written by
 * the execution engine and browsable from Admin → Executions / Logs.
 */
model ExecutionStep {
  id           String             @id @default(cuid())
  executionId  String
  execution    WorkflowExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId       String
  nodeType     String
  nodeName     String?
  status       String             @default("pending") // pending | running | success | failed | retrying | fallback | skipped | cancelled
  attempts     Json               @default("[]") // [{attempt, provider, model, status, latencyMs, error, costUsd}]
  latencyMs    Int                @default(0)
  error        String?
  provider     String?
  model        String?
  costUsd      Float              @default(0)
  outputRefs   Json               @default("[]") // artifact ids / output summaries per output port
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([executionId, nodeId])
}

/**
 * Central error log — every engine / routing / storage / adapter failure is
 * recorded here for the Admin → Logs & Errors page.
 */
model ErrorLog {
  id          String   @id @default(cuid())
  executionId String?
  nodeId      String?
  nodeType    String?
  source      String   @default("engine") // engine | routing | storage | tools | admin
  message     String
  stack       String?
  context     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([executionId])
}
